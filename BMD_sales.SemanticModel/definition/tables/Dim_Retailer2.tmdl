	column Territory_id =
			
			CALCULATE (
			    MAX ( Dim_Bazaar_Territory[territory_id] ),
			    FILTER (
			        Dim_Bazaar_Territory,
			        Dim_Bazaar_Territory[bazaar_list_id] = Dim_Retailer2[bazaar_id]
			            && Dim_Bazaar_Territory[organization_id] = Dim_Retailer2[organization_id]
			    )
			)
		formatString: 0
		lineageTag: c9916e54-5b94-436f-a425-0d108bbf1942
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

