table Dim_Retailer2
	lineageTag: e3de5c87-8561-43d3-acfe-6afb779253e5

	measure Total_Retailer_Count =
			
			CALCULATE (
			    COUNTROWS ( Dim_Retailer2 ),
			    REMOVEFILTERS ()
			)
		formatString: 0
		lineageTag: 494c4da3-8064-4783-9073-4043a84f1a6a

	measure Active_Retailers = ```
			
			CALCULATE (
			    DISTINCTCOUNT ( Fact_RetailOrder[retailer_id])
			)
			
			```
		formatString: 0
		lineageTag: 0b8cf235-897f-4bcf-a1bc-69c2735cb7e0

	measure Potential_Retailers = ```
			
			[Total_Retailer_Count] - [Active_Retailers]
			
			```
		formatString: 0
		lineageTag: 0bc4536e-31c9-4ef1-87d4-39dc9094990c

	measure Retailer_Visit_Count =
			
			CALCULATE (
			    [Total_Visits2],
			    Fact_Visit2[ClientType] = "Retailer",
			    TREATAS (
			        VALUES ( Dim_Retailer2[id] ),
			        Fact_Visit[ClientID]
			    )
			)
		formatString: 0
		lineageTag: e2e4e721-55b7-4358-8202-18fe43e3e839

	measure Total_Retailer_UncoverRetailer_Count = [Total_Retailer_Count]+[Total_Uncover_Retailer]
		formatString: 0
		lineageTag: fea9aa75-015b-4932-8485-eef26b568a99

	measure Total_Retailers_No_Duplicate_Logic =
			
			VAR Retailers_Not_From_Uncovered =
			    CALCULATE (
			        COUNTROWS ( Dim_Retailer2 ),
			        ISBLANK ( Dim_Retailer2[uncovered_retailer_id] )
			    )
			VAR Total_Uncovered =
			    [Total_Uncover_Retailer]
			RETURN
			Retailers_Not_From_Uncovered + Total_Uncovered
		formatString: 0
		lineageTag: 7d3b9304-8de4-4b31-b536-343b13778788

	measure Total_Retailers_date =
			
			CALCULATE (
			    DISTINCTCOUNT ( Dim_Retailer[RetailerID] ),
			    TREATAS (
			        VALUES ( Dim_Date[Date] ),
			        Dim_Retailer2[created_at]
			    )
			)
		formatString: 0
		lineageTag: 2f0e6f03-2d04-4800-a897-b343dff7ec14

	measure Total_Retailer_Count_ACL = ```
			
			CALCULATE (
			    COUNTROWS ( Dim_Retailer2 ),
			    REMOVEFILTERS (),
			    Dim_Retailer2[organization_id] = 1
			)
			
			```
		formatString: 0
		lineageTag: 93b756e1-dd7f-4b68-ae7a-7a0e7185b798

	measure Total_Retailer_Count_AIL = ```
			
			CALCULATE (
			    COUNTROWS ( Dim_Retailer2 ),
			    REMOVEFILTERS (),
			    Dim_Retailer2[organization_id] = 2
			)
			
			```
		formatString: 0
		lineageTag: d8d36a27-8468-4a67-b1f9-9e61195da922

	measure Total_Retailer_Count_ACSL = ```
			
			CALCULATE (
			    COUNTROWS ( Dim_Retailer2 ),
			    REMOVEFILTERS (),
			    Dim_Retailer2[organization_id] = 3
			)
			
			```
		formatString: 0
		lineageTag: 219a4f6c-18f6-4f44-8632-5c0da32b90a4

	measure Retailers_Created =
			
			CALCULATE (
			    COUNTROWS ( Dim_Retailer2 ),
			    USERELATIONSHIP (
			        Dim_Retailer2[created_at],
			        Dim_Date[Date]
			    )
			)
		formatString: 0
		lineageTag: 34c8b27d-906c-49be-ba50-d575acc39441

	measure Avg_Active_Retailers_per_Territory =
			
			AVERAGEX (
			    VALUES ( Dim_Retailer2[territory_id] ),
			    CALCULATE (
			        DISTINCTCOUNT ( Fact_RetailOrder[retailer_id] )
			    )
			)
		lineageTag: b4068819-72d5-498e-8e94-154bf8c63b40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Active_vs_Target_Retailer_ACL_Display =
			
			VAR Active = [Active_Retailers]
			VAR Total = [Total_Retailer_Count_ACL_Target]
			RETURN
			FORMAT ( Active, "0" ) & " / " & FORMAT ( Total, "0" )
		lineageTag: 1e5497f1-8dc0-4f63-ac56-0e9545d1c458

	measure Active_vs_Target_Retailer_ACL_Percentage =
			
			DIVIDE (
			    [Active_Retailers],
			    [Total_Retailer_Count_ACL_Target],
			    0
			)
		lineageTag: 4fca6624-fbb0-4d14-b3bb-359b8f90fef7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_Volume_Per_Retailer_Target = 200
		formatString: 0
		lineageTag: ef33d3f3-07b8-4f6f-95a0-85c24ff3d83c

	measure Avg_Vol_Retailer_vs_Target_Retailer_Percentage =
			
			DIVIDE (
			    [Avg_Volume_Per_Retailer],
			    [Avg_Volume_Per_Retailer_Target],
			    0
			)
		lineageTag: b46478d2-5b32-44c1-8a23-3da7a3d68af9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_Vol_Retailer_vs_Target_Retailer_Display =
			
			VAR Avg_Vol = [Avg_Volume_Per_Retailer]
			VAR Target = [Avg_Volume_Per_Retailer_Target]
			RETURN
			FORMAT ( Avg_Vol, "0" ) & " / " & FORMAT ( Target, "0" )
		lineageTag: ab08809c-100c-4e0f-a959-5059609f3cb1

	measure Total_Retailer_Count_ACL_Target = 500
		formatString: 0
		lineageTag: 5bd93c34-6dcc-4d46-b9b2-0c5bf87d06d0

	measure Active_Uncovered_Retailers = ```
			
			CALCULATE (
			    DISTINCTCOUNT ( Fact_RetailOrder[uncovered_retailer_id]),
			    YEAR ( Fact_RetailOrder[order_date] ) = YEAR ( TODAY() ),
			    MONTH ( Fact_RetailOrder[order_date] ) = MONTH ( TODAY() )
			)
			
			```
		formatString: 0
		lineageTag: 8bbbe1ec-7bb2-45cd-ad58-5cbce396fa7d

	measure Active_Retailer = [Active_Retailers] - [Active_Uncovered_Retailers]
		formatString: 0
		lineageTag: 5f625da2-7a8f-4d44-906f-11828df82e5c

	measure Active_Bazaars = DISTINCTCOUNT(Dim_Retailer2[bazaar_id])
		formatString: 0
		lineageTag: 2876c87a-e2fb-4064-a90d-fad60fc9f7fc

	measure Retailer_Count2 =
			
			DISTINCTCOUNT(Fact_RetailOrder[retailer_id])
		formatString: 0
		lineageTag: ba776f89-6c70-4d23-9b1e-2c3ae39e6386

