	measure Average_Daily_UserOrder_Price_ACSL =
			
			AVERAGEX (
			    FILTER (
			        Fact_ProjectConversion,
			        VAR RowPrice =
			            DIVIDE (
			                Fact_ProjectConversion[total_amount],
			                Fact_ProjectConversion[total_rft_quantity],
			                0
			            )
			        RETURN
			            RowPrice > 0
			                && RowPrice < 1000000
			    ),
			    DIVIDE (
			        Fact_ProjectConversion[total_amount],
			        Fact_ProjectConversion[total_rft_quantity],
			        0
			    )
			)
		lineageTag: cc358ca1-abb3-4b3f-904c-7174ca6d7ba4

