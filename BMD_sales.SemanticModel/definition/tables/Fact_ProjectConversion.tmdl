	measure Average_Daily_UserOrder_Price =
			
			AVERAGEX (
			    FILTER (
			        Fact_ProjectConversion,
			        VAR RowPrice =
			            DIVIDE (
			                Fact_ProjectConversion[total_amount],
			                Fact_ProjectConversion[total_quantity],
			                0
			            )
			        RETURN
			            RowPrice > 200
			                && RowPrice < 600
			    ),
			    DIVIDE (
			        Fact_ProjectConversion[total_amount],
			        Fact_ProjectConversion[total_quantity],
			        0
			    )
			)
		formatString: 0
		lineageTag: 0a0424ba-98c7-4f8b-8f10-366e6558243d

	measure Average_Daily_UserOrder_Price_AIL =
			
			AVERAGEX (
			    FILTER (
			        Fact_ProjectConversion,
			        VAR RowPrice =
			            DIVIDE (
			                Fact_ProjectConversion[total_amount],
			                Fact_ProjectConversion[total_quantity],
			                0
			            )
			        RETURN
			            RowPrice > 60000
			                && RowPrice < 90000
			    ),
			    DIVIDE (
			        Fact_ProjectConversion[total_amount],
			        Fact_ProjectConversion[total_quantity],
			        0
			    )
			)
		formatString: 0
		lineageTag: dc60102b-5aca-4bac-8a96-f1251b4b0942

