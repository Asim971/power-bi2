	measure Visit_Status_2 =
			
			VAR DistanceValue =
			    CALCULATE (
			        SELECTEDVALUE ( Fact_Visit2[Distance (M)_2] ),
			        REMOVEFILTERS ( Dim_EntityGroup[EntityGroup] )
			    )
			RETURN
			IF (
			    ISBLANK ( DistanceValue ),
			    BLANK(),
			    IF (
			        DistanceValue > 30,
			        "Bad Visit",
			        "Good Visit"
			    )
			)
		lineageTag: b8197648-5480-4fd8-b17d-5416b1275041

	measure Total_Bad_Visits =
			
