	column ClientType
		dataType: string
		lineageTag: f4053b6e-4cff-41bc-8194-183b07f1eaad
		summarizeBy: none
		sourceColumn: ClientType

		annotation SummarizationSetBy = Automatic

	column 'Distance (M)_2' = ```
			
			VAR VisitLat = Fact_Visit2[latitude]
			VAR VisitLng = Fact_Visit2[longitude]
			VAR ClientType = Fact_Visit2[ClientType]
			
			/* Resolve target latitude */
			VAR TargetLat =
			    SWITCH (
			        TRUE (),
			        ClientType = "Site",
			            LOOKUPVALUE (
			                Dim_Site[Latitude],
			                Dim_Site[SiteID], Fact_Visit2[potential_site_id]
			            ),
			        ClientType = "Retailer",
			            LOOKUPVALUE (
			                Dim_Retailer2[lat],
			                Dim_Retailer2[id], Fact_Visit2[retailer_id]
			            ),
			        ClientType = "UncoveredRetailer",
			            LOOKUPVALUE (
			                Dim_UncoverRetailer[Latitude],
			                Dim_UncoverRetailer[id], Fact_Visit2[uncovered_retailer_id]
			            ),
			        BLANK ()
			    )
			
			/* Resolve target longitude */
			VAR TargetLng =
			    SWITCH (
			        TRUE (),
			        ClientType = "Site",
			            LOOKUPVALUE (
			                Dim_Site[Longitude],
			                Dim_Site[SiteID], Fact_Visit2[potential_site_id]
			            ),
			        ClientType = "Retailer",
			            LOOKUPVALUE (
			                Dim_Retailer2[lng],
			                Dim_Retailer2[id], Fact_Visit2[retailer_id]
			            ),
			        ClientType = "UncoveredRetailer",
			            LOOKUPVALUE (
			                Dim_UncoverRetailer[Longitude],
			                Dim_UncoverRetailer[id], Fact_Visit2[uncovered_retailer_id]
			            ),
			        BLANK ()
			    )
			
			RETURN
			IF (
			    ISBLANK ( VisitLat )
			        || ISBLANK ( VisitLng )
			        || ISBLANK ( TargetLat )
			        || ISBLANK ( TargetLng ),
			    BLANK (),
			
			    VAR Lat1 = RADIANS ( VisitLat )
			    VAR Lon1 = RADIANS ( VisitLng )
			    VAR Lat2 = RADIANS ( TargetLat )
			    VAR Lon2 = RADIANS ( TargetLng )
			
			    VAR dLat = Lat2 - Lat1
			    VAR dLon = Lon2 - Lon1
			
			    VAR a =
			        SIN ( dLat / 2 ) * SIN ( dLat / 2 )
			            + COS ( Lat1 ) * COS ( Lat2 )
			            * SIN ( dLon / 2 ) * SIN ( dLon / 2 )
			
			    VAR c =
			        2 * ATAN ( SQRT ( a ) / SQRT ( 1 - a ) )
			
			    RETURN
			        6371000 * c
			)
			
			```
		lineageTag: 50dc2452-9eef-4f99-9c17-d1f72d84ff48
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

