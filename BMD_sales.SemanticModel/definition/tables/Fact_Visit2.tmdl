	measure 'Total Site + IHB Visits2' =
			
			CALCULATE (
			    [Total_Visits2],
			    Dim_Client_Simple[ClientType] IN { "Site", "IHB" },
			    REMOVEFILTERS ( Dim_EntityGroup[EntityGroup] )
			)
		formatString: 0
		lineageTag: ebe374c7-2c36-4629-a42e-d443d0468fa5

	measure Visit_Percentage_By_EntityGroup = ```
			
			DIVIDE (
			    [Total_Visits2],
			    CALCULATE (
