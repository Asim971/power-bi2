				  #"Added custom 3" = Table.TransformColumnTypes(Table.AddColumn(#"Changed column type", "Contractor_HeadMason_Id", each if [contractor_id] <> null then [contractor_id]
				else if [head_mason_id] <> null then [head_mason_id]
				else null), {{"Contractor_HeadMason_Id", Int64.Type}})
				in
