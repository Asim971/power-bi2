	measure Total_UncoverRetailer_Visits2 =
			
			SUMX (
			    VALUES ( Dim_Date[Date] ),
			    CALCULATE (
			        COUNT ( Fact_Visit2[ClientKey] ),
			        Dim_Client_Simple[ClientType] = "UncoveredRetailer",
			        REMOVEFILTERS ( Dim_EntityGroup[EntityGroup] )
			    )
