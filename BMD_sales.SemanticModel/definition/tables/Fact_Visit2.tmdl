				else if [carpenter_id] <> null then "Carpenter-" & Text.From([carpenter_id])
				else if [lead_id] <> null and [end_user] = "NO" then "Lead-" & Text.From([lead_id])
				else if [lead_id] <> null and [end_user] = "YES" then "EndUser-" & Text.From([lead_id])
				else null), {{"ClientKey", type text}}),
