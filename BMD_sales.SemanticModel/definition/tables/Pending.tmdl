		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Remaining_Due_For_SR_New =
			
			SUMX (
			    VALUES ( Dim_Contractor_HeadMason[PartnerID] ),
			    VAR Due = [Due_For_SR_New]
			    VAR Processing = [Processing]
			    VAR Paid = [Net_Paid]
			    VAR ReturnAmount = [Return]
			    VAR Remaining = Due - Processing - Paid - ReturnAmount
			    RETURN IF ( Remaining > 0, Remaining, 0 )
			)
		lineageTag: b1843c47-c670-4367-98a1-cf2ec18eb871

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Remaining_Due_For_SR_New2 =
			
