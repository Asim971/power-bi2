table Pending
	lineageTag: 07fb456b-ba79-449d-8465-79f212846f8b

	measure Pending =
			
			CALCULATE (
			    [Total_PartnerEligible_Orders_Bags] * 3,
			    NOT ISBLANK ( Dim_Contractor_HeadMason[PartnerID] )
			)
		formatString: 0
		lineageTag: 3473f589-1538-4b3a-874d-7d5259a9f104

	measure Pending_For_SR = ```
			
			VAR Result =
			    CALCULATE (
			        [Total_PartnerEligible_Orders_Bags] * 3,
			        NOT ISBLANK ( Dim_Contractor_HeadMason[PartnerID] ),
			        Dim_User[RoleName] = "Sr",
			        Fact_ProjectConversion[order_status] <> "APPROVED",
			        Fact_ProjectConversion[order_status] <> "REJECTED"
			    )
			RETURN
			IF ( ISBLANK ( Result ), 0, Result )
			
			```
		formatString: 0
		lineageTag: e4a262ff-9a94-45f1-b7f7-7e2d91a11750

	measure Due_For_SR =
			
			VAR Result =
			    CALCULATE (
			        [Total_PartnerEligible_Orders_Bags] * 3,
			        NOT ISBLANK ( Dim_Contractor_HeadMason[PartnerID] ),
			        Dim_User[RoleName] = "Sr",
			    Fact_ProjectConversion[order_status] = "APPROVED"
			    )
			RETURN
			IF (
			    ISBLANK ( Result ),
			    0,
			    Result
			)
		formatString: 0
		lineageTag: 1ad26a09-03a8-430b-be5e-c0b0030cfac8

	measure Remaining_Due_For_SR = ```
			
			VAR Remaining =
			    [Due_For_SR]
			    - [Processing]
			    - [Net_Paid]
			    - [Return]
			RETURN
			IF ( Remaining <= 0, 0, Remaining )
			
			```
		formatString: 0
		lineageTag: 4d1cc3cc-bea6-4371-8bf3-6004f506c02b

	measure Total_Pending_For_SR = ```
			
			VAR Result =
			    CALCULATE (
			        [Total_PartnerEligible_Orders_Bags] * 3,
			        NOT ISBLANK ( Dim_Contractor_HeadMason[PartnerID] ),
			        Dim_User[RoleName] = "Sr"
			    )
			RETURN
			IF ( ISBLANK ( Result ), 0, Result )
			
			```
		formatString: 0
		lineageTag: baf5df4b-729f-4ec4-865d-aaf135c93f11

	measure Partner_Incentive_Rate = ```
			
			VAR Bags = [Total_PartnerEligible_Orders_Bags]
			RETURN
			SWITCH (
			    TRUE(),
			    Bags >= 1000, 8.00,
			    Bags >= 700,  6.00,
			    Bags >= 500,  5.00,
			    Bags >= 300,  4.00,
			    Bags >= 200,  3.50,
			    Bags >= 100,  3.00,
			    Bags >= 50,   2.50,
			    0
			)
			
			```
		lineageTag: 784d7d89-46eb-4ebf-931a-742075338a23

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Pending_For_SR_New = ```
			
			SUMX (
			    VALUES ( Dim_Contractor_HeadMason[PartnerID] ),
			    VAR Bags =
			        CALCULATE (
			            [Total_PartnerEligible_Orders_Bags],
			            Dim_User[RoleName] = "Sr",
			            Fact_ProjectConversion[order_status] = "PENDING"
			        )
			    VAR Rate =
			        SWITCH (
			            TRUE(),
			            Bags >= 1000, 8.00,
			            Bags >= 700,  6.00,
			            Bags >= 500,  5.00,
			            Bags >= 300,  4.00,
			            Bags >= 200,  3.50,
			            Bags >= 100,  3.00,
			            Bags >= 50,   2.50,
			            0
			        )
			    RETURN
			        Bags * Rate
			)
			
			```
		lineageTag: 1c97f365-952c-45ea-bfc2-77ddf3049a51

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Due_For_SR_New = ```
			
